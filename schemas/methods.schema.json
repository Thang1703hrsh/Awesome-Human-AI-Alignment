{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/human-alignment/methods.schema.json",
  "title": "Human-AI Alignment Software Methods",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "taxonomy_categories", "stage", "implementation_status"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
      "name": {"type": "string", "minLength": 1},
      "taxonomy_categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "stage": {"enum": ["supervision", "training", "inference", "assurance"]},
      "implementation_status": {
        "enum": ["catalog", "adapter", "reference", "native", "external"]
      }
    },
    "additionalProperties": false
  }
}
